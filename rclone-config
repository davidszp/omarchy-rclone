#!/usr/bin/env python3
"""Drive rclone's interactive config STATE MACHINE one step at a time, and
normalise each step into the small JSON object the panel renders.

    rclone-config start   <name> <type>  first question (new remotes only)
    rclone-config connect <name> <type>  create and take every default (Drive wizard)
    rclone-config resume <name>          reconfigure an EXISTING remote
    rclone-config next   <name> <state>  answer, and get the next question
    rclone-config abort  <name>          delete a half-configured remote

VALUES NEVER TRAVEL IN ARGV. `start` reads {"parameters": {...}} and `next`
reads {"result": "..."} as JSON on **stdin**; argv carries only a verb, a remote
name and an opaque state string. This is the fix for a marketplace review
finding: the old form was `rclone-config next <name> <state> <result>`, which
became `rclone config update … --result <secret>`, and every value the panel
collected — SFTP and WebDAV passwords, S3 secret keys, the Drive client secret —
was readable from /proc/<pid>/cmdline by any local process for the length of the
call. rclone has no stdin input for config values (`--json` is argv too), so the
CLI could not be used safely; this goes to the daemon's rc API instead, where
the values sit in an HTTP body.

Written in Python rather than shell because it now builds and parses JSON around
credentials, and quoting those through a shell is the same class of mistake.

Why a state machine at all: plain backend options (S3 keys, SFTP host…) are NOT
asked this way — measured, every non-OAuth backend returns done on the first
call, because its options are ordinary key=value settings. The machine exists
for OAuth flows and the pickers that follow them: OneDrive's state is
`*oauth-islocal,choose_type,,`, meaning that after you authenticate it still has
to ask which drive. That post-auth question, not the browser handshake, is what
a one-shot create cannot answer.
"""

import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import rcclient  # noqa: E402

# The OAuth handshake waits for a human to finish in a browser, so this cannot
# use the short poll timeout. rclone itself gives up long before we do.
FLOW_TIMEOUT = 600

# rclone does NOT set IsPassword for every sensitive field — measured: the Drive
# client_secret step reports IsPassword false. Masking only on that flag would
# show a live client secret in plain text, so fall back to the field name. False
# positives here cost nothing; a false negative leaks.
SENSITIVE = ("secret", "password", "passwd", "token", "key")

# Replay a scripted sequence instead of calling rclone, so the panel's handling
# of a MULTI-STEP flow — specifically a post-auth picker like OneDrive's
# choose_type — can be tested without a live account. Reserved type name; rclone
# has no backend called __fixture__.
FIXTURE_TYPE = "__fixture__"
FIXTURE_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                            "test", "fixtures", "onedrive-like.json")


def fail(message):
    print(json.dumps({"ok": False, "done": True, "state": "", "error": message}))
    return 0


def normalise(payload, error):
    """rclone's verbose step -> the few fields the panel actually renders."""
    if error:
        # rclone's hard refusals arrive as a sentence, not a structure — "no
        # region set" for zoho. Reporting "could not parse" hid the one line
        # that says what is actually wrong.
        return {"ok": False, "done": True, "state": "",
                "error": error or "rclone could not start this setup"}

    option = payload.get("Option")
    state = payload.get("State") or ""

    # A flow is finished ONLY when there is no state left. rclone returns
    # intermediate steps with a State but NO Option — its state strings are a
    # stack (`*oauth-islocal,choose_type,,` means: after oauth, still do
    # choose_type), and such a step must be continued with an empty result.
    #
    # Treating "no Option" as done is what silently truncated OneDrive setup
    # after the browser sign-in: the remote was written with only a token, and
    # mounting then failed with "unable to get drive_id and drive_type".
    if not option:
        return {"ok": True, "done": state == "", "state": state, "name": "",
                "help": "", "default": "", "required": False, "hidden": False,
                "secret": False, "examples": []}

    name = str(option.get("Name") or "")
    default = option.get("Default")
    if isinstance(default, bool):
        # str(True) is "True", but rclone's Examples use "true"/"false", so a
        # Python-cased default would never match the choice it belongs to.
        default = "true" if default else "false"
    default = "" if default is None else str(default)

    return {
        "ok": True,
        "done": False,
        "state": state,
        "name": name,
        "help": str(option.get("Help") or ""),
        "default": default,
        "required": option.get("Required") is True,
        # Hide is a bitfield; non-zero means rclone would not show it.
        "hidden": bool(option.get("Hide")),
        "secret": (option.get("IsPassword") is True
                   or option.get("Sensitive") is True
                   or any(word in name.lower() for word in SENSITIVE)),
        "examples": [{"value": str(e.get("Value", "")), "help": str(e.get("Help", ""))}
                     for e in (option.get("Examples") or [])],
    }


def fixture_step(after_state):
    try:
        with open(FIXTURE_FILE, encoding="utf-8") as handle:
            steps = json.load(handle)
    except (OSError, ValueError):
        return {"ok": False, "done": True, "state": "", "error": "fixture missing"}
    if after_state == "":
        step = steps[0]
    else:
        index = next((i for i, s in enumerate(steps) if s["state"] == after_state), None)
        step = steps[index + 1] if index is not None and index + 1 < len(steps) else None
    if step is None:
        return {"ok": True, "done": True, "state": ""}
    step = dict(step)
    step["ok"] = True
    step["done"] = False
    return step


def stdin_json():
    """The request body. Absent stdin is an empty request, not an error."""
    if sys.stdin.isatty():
        return {}
    raw = sys.stdin.read()
    if not raw.strip():
        return {}
    try:
        value = json.loads(raw)
    except ValueError:
        return {}
    return value if isinstance(value, dict) else {}


def existing_remote_names():
    """Remote names in the config FILE — deliberately not the daemon's view.

    A `config/create` that fails leaves the half-built remote in the daemon's
    IN-MEMORY config while never writing it to disk: measured, after a create
    with a bad backend type the daemon's `config/dump` lists it and both the file
    and `rclone config dump` are empty. Asking the daemon would therefore refuse
    a legitimate retry of the same name — "already exists — use resume" — with
    nothing on disk to resume, which is a dead end for the user.

    Only the section NAMES are read, so no token or password is loaded.

    Falls back to the daemon's view rather than to "nothing exists": a false
    refusal costs the user a different name, while a false permit would let
    `config create` silently discard a working remote's token.
    """
    paths, error = rcclient.call("config/paths", {})
    path = (paths or {}).get("config") if not error else None
    if path:
        try:
            with open(path, encoding="utf-8") as handle:
                return {line.strip()[1:-1].strip()
                        for line in handle
                        if line.strip().startswith("[") and line.strip().endswith("]")}
        except OSError:
            pass
    dump, error = rcclient.call("config/dump", {})
    return set(dump) if not error and isinstance(dump, dict) else set()


def config_call(method, name, parameters=None, opt=None, backend=None):
    """One step of the machine. `backend` is only meaningful for config/create,
    where rclone takes the type beside the name rather than inside `opt`."""
    body = {"name": name, "parameters": parameters or {}}
    if backend:
        body["type"] = backend
    # Deliberately NOT passing `obscure`/`noObscure`: measured, the rc API
    # obscures a plain password on its own, exactly as `config create
    # --non-interactive` did, and declaring it again risks obscuring twice.
    body["opt"] = dict(opt or {}, nonInteractive=True)
    return rcclient.call(method, body, timeout=FLOW_TIMEOUT)


def run_until_question(payload, error, name):
    """Continue while rclone returns states that carry no question, so the
    caller only ever sees a step a human can answer."""
    step = normalise(payload, error)
    for _ in range(10):
        if step.get("done") or step.get("name") or not step.get("ok"):
            return step
        state = step.get("state") or ""
        if not state:
            return step
        payload, error = config_call("config/update", name,
                                     opt={"continue": True, "state": state, "result": ""})
        step = normalise(payload, error)
    return step


def main(argv):
    action = argv[1] if len(argv) > 1 else ""
    name = argv[2] if len(argv) > 2 else ""
    if not action or not name:
        sys.stderr.write("usage: rclone-config <start|connect|resume|next|abort> <name> "
                         "[type|state]\n")
        return 2

    if action == "start":
        backend = argv[3] if len(argv) > 3 else ""
        if not backend:
            sys.stderr.write("start needs a backend type\n")
            return 2
        if backend == FIXTURE_TYPE:
            print(json.dumps(fixture_step("")))
            return 0
        # `config create` RECREATES an existing remote from scratch — it
        # silently discards its token and every other setting — so starting a
        # flow on a name that already exists is destructive. Callers pick a free
        # name with Model.suggestRemoteName(); repairing one is `resume`.
        if name in existing_remote_names():
            return fail("remote %s already exists — use resume to reconfigure it" % name)
        # Seeds: values the flow never asks for but the backend refuses to start
        # without (zoho stops at "Error: no region set"). On stdin with
        # everything else, because some are credentials.
        parameters = stdin_json().get("parameters") or {}
        payload, error = config_call(
            "config/create", name, backend=backend,
            parameters={str(k): str(v) for k, v in parameters.items()})
        print(json.dumps(run_until_question(payload, error, name)))
        return 0

    if action == "connect":
        # One-shot: create the remote from the values on stdin, then walk the
        # whole machine taking every question's DEFAULT. That is what the Drive
        # wizard needs, and it is faithful to what it used to do — the old
        # wrapper piped the client secret into an interactive `rclone config
        # create`, so rclone's stdin hit EOF at the first question and every
        # answer fell back to its default. `config_is_local` defaults to true,
        # which is what starts the browser handshake.
        #
        # Only for a flow the caller has already decided is the plain
        # local-browser case. Anything that needs a real choice — OneDrive
        # picking a drive — must use start/next so a human answers it.
        backend = argv[3] if len(argv) > 3 else ""
        if not backend:
            sys.stderr.write("connect needs a backend type\n")
            return 2
        parameters = stdin_json().get("parameters") or {}
        payload, error = config_call(
            "config/create", name, backend=backend,
            parameters={str(k): str(v) for k, v in parameters.items()})
        step = normalise(payload, error)
        for _ in range(12):
            if not step.get("ok"):
                print(json.dumps(step))
                return 0
            if step.get("done"):
                print(json.dumps({"ok": True, "done": True, "state": ""}))
                return 0
            payload, error = config_call(
                "config/update", name,
                opt={"continue": True, "state": step.get("state") or "",
                     "result": step.get("default") or ""})
            step = normalise(payload, error)
        return fail("setup did not finish after 12 steps")

    if action == "resume":
        # Reconfigure an EXISTING remote without recreating it: rclone re-enters
        # its state machine and offers to keep the current token, so a
        # half-finished setup can be completed without another browser sign-in.
        payload, error = config_call("config/update", name)
        print(json.dumps(run_until_question(payload, error, name)))
        return 0

    if action == "next":
        state = argv[3] if len(argv) > 3 else ""
        if not state:
            sys.stderr.write("next needs a state\n")
            return 2
        if state.startswith("fx_"):
            print(json.dumps(fixture_step(state)))
            return 0
        result = stdin_json().get("result", "")
        payload, error = config_call("config/update", name,
                                     opt={"continue": True, "state": state,
                                          "result": str(result)})
        print(json.dumps(run_until_question(payload, error, name)))
        return 0

    if action == "abort":
        # An abandoned flow can also leave rclone's OAuth callback server
        # listening on :53682, which then refuses the next flow's handshake.
        # rclone's own docs point at oauthstop to recover from an interrupted
        # flow without restarting the daemon. It errors when nothing is running,
        # which is the normal case and is ignored.
        rcclient.call("config/oauthstop", {})
        # A flow abandoned midway leaves a partial remote behind; drop it rather
        # than leaving something half-made in the user's config.
        rcclient.call("config/delete", {"name": name})
        print(json.dumps({"ok": True, "done": True, "state": ""}))
        return 0

    sys.stderr.write("usage: rclone-config <start|connect|resume|next|abort> <name> "
                     "[type|state]\n")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
